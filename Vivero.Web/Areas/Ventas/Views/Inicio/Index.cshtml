@{
    ViewData["Title"] = "Ventas y Pedidos";
}

<h2>Ventas y Pedidos</h2>
<p class="text-muted">Equipo Dinamita. Ventas en vivero, clientes y pedidos en línea.</p>

<div class="row g-3">
    @if (User.IsInRole(RolesSistema.Administrador) || User.IsInRole(RolesSistema.Supervisor))
    {
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <span class="badge bg-success mb-2">CU09</span>
                    <h5 class="card-title">Registrar venta en vivero</h5>
                    <p class="card-text small text-muted mb-1">Responsable: Stif Lazo Barreto</p>
                    <p class="card-text small text-muted">Roles: Administrador, Supervisor</p>
                    <a class="btn btn-outline-success btn-sm" asp-area="Ventas" asp-controller="RegistrarVenta" asp-action="Index">Abrir</a>
                </div>
            </div>
        </div>
    }
    @if (User.IsInRole(RolesSistema.Administrador) || User.IsInRole(RolesSistema.Supervisor))
    {
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <span class="badge bg-success mb-2">CU10</span>
                    <h5 class="card-title">Ver historial de ventas</h5>
                    <p class="card-text small text-muted mb-1">Responsable: Stif Lazo Barreto</p>
                    <p class="card-text small text-muted">Roles: Administrador, Supervisor</p>
                    <a class="btn btn-outline-success btn-sm" asp-area="Ventas" asp-controller="HistorialVentas" asp-action="Index">Abrir</a>
                </div>
            </div>
        </div>
    }
    @if (User.IsInRole(RolesSistema.Administrador))
    {
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <span class="badge bg-success mb-2">CU11</span>
                    <h5 class="card-title">Ver reporte de ventas</h5>
                    <p class="card-text small text-muted mb-1">Responsable: Stif Lazo Barreto</p>
                    <p class="card-text small text-muted">Roles: Administrador</p>
                    <a class="btn btn-outline-success btn-sm" asp-area="Ventas" asp-controller="ReporteVentas" asp-action="Index">Abrir</a>
                </div>
            </div>
        </div>
    }
    @if (User.IsInRole(RolesSistema.Administrador) || User.IsInRole(RolesSistema.Supervisor))
    {
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <span class="badge bg-success mb-2">CU12</span>
                    <h5 class="card-title">Registrar cliente</h5>
                    <p class="card-text small text-muted mb-1">Responsable: Stif Lazo Barreto</p>
                    <p class="card-text small text-muted">Roles: Administrador, Supervisor</p>
                    <a class="btn btn-outline-success btn-sm" asp-area="Ventas" asp-controller="RegistrarCliente" asp-action="Index">Abrir</a>
                </div>
            </div>
        </div>
    }
    @if (User.IsInRole(RolesSistema.Administrador) || User.IsInRole(RolesSistema.Supervisor))
    {
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <span class="badge bg-success mb-2">CU13</span>
                    <h5 class="card-title">Actualizar datos de cliente</h5>
                    <p class="card-text small text-muted mb-1">Responsable: Stif Lazo Barreto</p>
                    <p class="card-text small text-muted">Roles: Administrador, Supervisor</p>
                    <a class="btn btn-outline-success btn-sm" asp-area="Ventas" asp-controller="ActualizarCliente" asp-action="Index">Abrir</a>
                </div>
            </div>
        </div>
    }
    @if (User.IsInRole(RolesSistema.Cliente))
    {
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <span class="badge bg-success mb-2">CU14</span>
                    <h5 class="card-title">Realizar pedido en línea</h5>
                    <p class="card-text small text-muted mb-1">Responsable: Jhamil Flores Choque</p>
                    <p class="card-text small text-muted">Roles: Cliente</p>
                    <a class="btn btn-outline-success btn-sm" asp-area="Ventas" asp-controller="RealizarPedido" asp-action="Index">Abrir</a>
                </div>
            </div>
        </div>
    }
    @if (User.IsInRole(RolesSistema.Cliente))
    {
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <span class="badge bg-success mb-2">CU15</span>
                    <h5 class="card-title">Cancelar pedido</h5>
                    <p class="card-text small text-muted mb-1">Responsable: Jhamil Flores Choque</p>
                    <p class="card-text small text-muted">Roles: Cliente</p>
                    <a class="btn btn-outline-success btn-sm" asp-area="Ventas" asp-controller="CancelarPedido" asp-action="Index">Abrir</a>
                </div>
            </div>
        </div>
    }
    @if (User.IsInRole(RolesSistema.Administrador) || User.IsInRole(RolesSistema.Supervisor) || User.IsInRole(RolesSistema.Cliente))
    {
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <span class="badge bg-success mb-2">CU16</span>
                    <h5 class="card-title">Consultar catálogo de plantas</h5>
                    <p class="card-text small text-muted mb-1">Responsable: Jhamil Flores Choque</p>
                    <p class="card-text small text-muted">Roles: Administrador, Supervisor, Cliente</p>
                    <a class="btn btn-outline-success btn-sm" asp-area="Ventas" asp-controller="CatalogoPlantas" asp-action="Index">Abrir</a>
                </div>
            </div>
        </div>
    }
    @if (User.IsInRole(RolesSistema.Administrador) || User.IsInRole(RolesSistema.Supervisor) || User.IsInRole(RolesSistema.Cliente))
    {
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <span class="badge bg-success mb-2">CU17</span>
                    <h5 class="card-title">Consultar historial de compras</h5>
                    <p class="card-text small text-muted mb-1">Responsable: Jhamil Flores Choque</p>
                    <p class="card-text small text-muted">Roles: Administrador, Supervisor, Cliente</p>
                    <a class="btn btn-outline-success btn-sm" asp-area="Ventas" asp-controller="HistorialCompras" asp-action="Index">Abrir</a>
                </div>
            </div>
        </div>
    }
    @if (User.IsInRole(RolesSistema.Administrador) || User.IsInRole(RolesSistema.Supervisor))
    {
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <span class="badge bg-success mb-2">CU18</span>
                    <h5 class="card-title">Revisar y aprobar pedido en línea</h5>
                    <p class="card-text small text-muted mb-1">Responsable: Jhamil Flores Choque</p>
                    <p class="card-text small text-muted">Roles: Administrador, Supervisor</p>
                    <a class="btn btn-outline-success btn-sm" asp-area="Ventas" asp-controller="AprobarPedido" asp-action="Index">Abrir</a>
                </div>
            </div>
        </div>
    }
</div>
