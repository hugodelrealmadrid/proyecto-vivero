@{
    ViewData["Title"] = "Gestión de Plantas";
}

<h2>Gestión de Plantas</h2>
<p class="text-muted">Equipo Code³. Registro, actualización, cuidado y baja de plantas; órdenes de compra de suministros.</p>

<div class="row g-3">
    @if (User.IsInRole(RolesSistema.Administrador) || User.IsInRole(RolesSistema.Supervisor) || User.IsInRole(RolesSistema.Jardinero))
    {
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <span class="badge bg-success mb-2">CU04</span>
                    <h5 class="card-title">Registrar planta</h5>
                    <p class="card-text small text-muted mb-1">Responsable: Brener Garcia Flores</p>
                    <p class="card-text small text-muted">Roles: Administrador, Supervisor, Jardinero</p>
                    <a class="btn btn-outline-success btn-sm" asp-area="Plantas" asp-controller="RegistrarPlanta" asp-action="Index">Abrir</a>
                </div>
            </div>
        </div>
    }
    @if (User.IsInRole(RolesSistema.Administrador) || User.IsInRole(RolesSistema.Supervisor))
    {
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <span class="badge bg-success mb-2">CU05</span>
                    <h5 class="card-title">Actualizar cantidad y estado de las plantas</h5>
                    <p class="card-text small text-muted mb-1">Responsable: Emily Betel Condori Pocori</p>
                    <p class="card-text small text-muted">Roles: Administrador, Supervisor</p>
                    <a class="btn btn-outline-success btn-sm" asp-area="Plantas" asp-controller="ActualizarPlanta" asp-action="Index">Abrir</a>
                </div>
            </div>
        </div>
    }
    @if (User.IsInRole(RolesSistema.Administrador) || User.IsInRole(RolesSistema.Supervisor) || User.IsInRole(RolesSistema.Jardinero))
    {
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <span class="badge bg-success mb-2">CU06</span>
                    <h5 class="card-title">Registrar actividades / reportes de cuidado</h5>
                    <p class="card-text small text-muted mb-1">Responsable: Ariel Rodrigo Rocabado</p>
                    <p class="card-text small text-muted">Roles: Administrador, Supervisor, Jardinero</p>
                    <a class="btn btn-outline-success btn-sm" asp-area="Plantas" asp-controller="ActividadPlanta" asp-action="Index">Abrir</a>
                </div>
            </div>
        </div>
    }
    @if (User.IsInRole(RolesSistema.Administrador) || User.IsInRole(RolesSistema.Supervisor))
    {
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <span class="badge bg-success mb-2">CU07</span>
                    <h5 class="card-title">Dar de baja una planta o lote</h5>
                    <p class="card-text small text-muted mb-1">Responsable: Sidny Abigail Mendoza Vargas</p>
                    <p class="card-text small text-muted">Roles: Administrador, Supervisor</p>
                    <a class="btn btn-outline-success btn-sm" asp-area="Plantas" asp-controller="BajaPlanta" asp-action="Index">Abrir</a>
                </div>
            </div>
        </div>
    }
    @if (User.IsInRole(RolesSistema.Administrador) || User.IsInRole(RolesSistema.Supervisor))
    {
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <span class="badge bg-success mb-2">CU08</span>
                    <h5 class="card-title">Generar orden de compra de suministros</h5>
                    <p class="card-text small text-muted mb-1">Responsable: Ariel Rodrigo Rocabado</p>
                    <p class="card-text small text-muted">Roles: Administrador, Supervisor</p>
                    <a class="btn btn-outline-success btn-sm" asp-area="Plantas" asp-controller="OrdenCompra" asp-action="Index">Abrir</a>
                </div>
            </div>
        </div>
    }
</div>
