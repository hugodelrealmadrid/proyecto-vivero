@{
    ViewData["Title"] = "Gestión de Entregas";
}

<h2>Gestión de Entregas</h2>
<p class="text-muted">Equipo Dinamita. Registro, asignación, seguimiento y reporte de entregas de pedidos.</p>

<div class="row g-3">
    @if (User.IsInRole(RolesSistema.Administrador) || User.IsInRole(RolesSistema.Supervisor))
    {
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <span class="badge bg-success mb-2">CU01</span>
                    <h5 class="card-title">Registrar entrega</h5>
                    <p class="card-text small text-muted mb-1">Responsable: Franz Villarroel Jattaco</p>
                    <p class="card-text small text-muted">Roles: Administrador, Supervisor</p>
                    <a class="btn btn-outline-success btn-sm" asp-area="Entregas" asp-controller="RegistrarEntrega" asp-action="Index">Abrir</a>
                </div>
            </div>
        </div>
    }
    @if (User.IsInRole(RolesSistema.Administrador) || User.IsInRole(RolesSistema.Supervisor))
    {
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <span class="badge bg-success mb-2">CU02</span>
                    <h5 class="card-title">Asignar vehículo</h5>
                    <p class="card-text small text-muted mb-1">Responsable: Franz Villarroel Jattaco</p>
                    <p class="card-text small text-muted">Roles: Administrador, Supervisor</p>
                    <a class="btn btn-outline-success btn-sm" asp-area="Entregas" asp-controller="AsignarVehiculo" asp-action="Index">Abrir</a>
                </div>
            </div>
        </div>
    }
    @if (User.IsInRole(RolesSistema.Administrador) || User.IsInRole(RolesSistema.Supervisor))
    {
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <span class="badge bg-success mb-2">CU03</span>
                    <h5 class="card-title">Asignar conductor</h5>
                    <p class="card-text small text-muted mb-1">Responsable: Franz Villarroel Jattaco</p>
                    <p class="card-text small text-muted">Roles: Administrador, Supervisor</p>
                    <a class="btn btn-outline-success btn-sm" asp-area="Entregas" asp-controller="AsignarConductor" asp-action="Index">Abrir</a>
                </div>
            </div>
        </div>
    }
    @if (User.IsInRole(RolesSistema.Administrador) || User.IsInRole(RolesSistema.Supervisor) || User.IsInRole(RolesSistema.Conductor))
    {
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <span class="badge bg-success mb-2">CU04</span>
                    <h5 class="card-title">Ver entregas pendientes</h5>
                    <p class="card-text small text-muted mb-1">Responsable: Franz Villarroel Jattaco</p>
                    <p class="card-text small text-muted">Roles: Administrador, Supervisor, Conductor</p>
                    <a class="btn btn-outline-success btn-sm" asp-area="Entregas" asp-controller="EntregasPendientes" asp-action="Index">Abrir</a>
                </div>
            </div>
        </div>
    }
    @if (User.IsInRole(RolesSistema.Administrador) || User.IsInRole(RolesSistema.Conductor))
    {
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <span class="badge bg-success mb-2">CU05</span>
                    <h5 class="card-title">Actualizar estado de entrega</h5>
                    <p class="card-text small text-muted mb-1">Responsable: Jhery Rodriguez Aguilar</p>
                    <p class="card-text small text-muted">Roles: Administrador, Conductor</p>
                    <a class="btn btn-outline-success btn-sm" asp-area="Entregas" asp-controller="ActualizarEstadoEntrega" asp-action="Index">Abrir</a>
                </div>
            </div>
        </div>
    }
    @if (User.IsInRole(RolesSistema.Administrador) || User.IsInRole(RolesSistema.Conductor))
    {
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <span class="badge bg-success mb-2">CU06</span>
                    <h5 class="card-title">Registrar incidencia de entrega</h5>
                    <p class="card-text small text-muted mb-1">Responsable: Jhery Rodriguez Aguilar</p>
                    <p class="card-text small text-muted">Roles: Administrador, Conductor</p>
                    <a class="btn btn-outline-success btn-sm" asp-area="Entregas" asp-controller="RegistrarIncidencia" asp-action="Index">Abrir</a>
                </div>
            </div>
        </div>
    }
    @if (User.IsInRole(RolesSistema.Cliente))
    {
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <span class="badge bg-success mb-2">CU07</span>
                    <h5 class="card-title">Confirmar recepción de pedido</h5>
                    <p class="card-text small text-muted mb-1">Responsable: Jhery Rodriguez Aguilar</p>
                    <p class="card-text small text-muted">Roles: Cliente</p>
                    <a class="btn btn-outline-success btn-sm" asp-area="Entregas" asp-controller="ConfirmarRecepcion" asp-action="Index">Abrir</a>
                </div>
            </div>
        </div>
    }
    @if (User.IsInRole(RolesSistema.Administrador))
    {
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <span class="badge bg-success mb-2">CU08</span>
                    <h5 class="card-title">Ver reporte de entregas</h5>
                    <p class="card-text small text-muted mb-1">Responsable: Jhery Rodriguez Aguilar</p>
                    <p class="card-text small text-muted">Roles: Administrador</p>
                    <a class="btn btn-outline-success btn-sm" asp-area="Entregas" asp-controller="ReporteEntregas" asp-action="Index">Abrir</a>
                </div>
            </div>
        </div>
    }
</div>
