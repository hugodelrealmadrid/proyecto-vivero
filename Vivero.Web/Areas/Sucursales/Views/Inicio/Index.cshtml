@{
    ViewData["Title"] = "Gestión de Sucursales";
}

<h2>Gestión de Sucursales</h2>
<p class="text-muted">Equipo Mapache. Registro, edición, baja y listado de sucursales; asignación de personal.</p>

<div class="row g-3">
    @if (User.IsInRole(RolesSistema.Administrador))
    {
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <span class="badge bg-success mb-2">UC1</span>
                    <h5 class="card-title">Registrar sucursal</h5>
                    <p class="card-text small text-muted mb-1">Responsable: Alaitz Keyra Felipez Ledezma</p>
                    <p class="card-text small text-muted">Roles: Administrador</p>
                    <a class="btn btn-outline-success btn-sm" asp-area="Sucursales" asp-controller="RegistrarSucursal" asp-action="Index">Abrir</a>
                </div>
            </div>
        </div>
    }
    @if (User.IsInRole(RolesSistema.Administrador))
    {
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <span class="badge bg-success mb-2">UC2</span>
                    <h5 class="card-title">Editar datos de sucursal</h5>
                    <p class="card-text small text-muted mb-1">Responsable: Alaitz Keyra Felipez Ledezma</p>
                    <p class="card-text small text-muted">Roles: Administrador</p>
                    <a class="btn btn-outline-success btn-sm" asp-area="Sucursales" asp-controller="EditarSucursal" asp-action="Index">Abrir</a>
                </div>
            </div>
        </div>
    }
    @if (User.IsInRole(RolesSistema.Administrador))
    {
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <span class="badge bg-success mb-2">UC3</span>
                    <h5 class="card-title">Dar de baja / desactivar sucursal</h5>
                    <p class="card-text small text-muted mb-1">Responsable: Alaitz Keyra Felipez Ledezma</p>
                    <p class="card-text small text-muted">Roles: Administrador</p>
                    <a class="btn btn-outline-success btn-sm" asp-area="Sucursales" asp-controller="BajaSucursal" asp-action="Index">Abrir</a>
                </div>
            </div>
        </div>
    }
    @if (User.IsInRole(RolesSistema.Administrador))
    {
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <span class="badge bg-success mb-2">UC4</span>
                    <h5 class="card-title">Asignar personal a una sucursal</h5>
                    <p class="card-text small text-muted mb-1">Responsable: Alaitz Keyra Felipez Ledezma</p>
                    <p class="card-text small text-muted">Roles: Administrador</p>
                    <a class="btn btn-outline-success btn-sm" asp-area="Sucursales" asp-controller="AsignarPersonal" asp-action="Index">Abrir</a>
                </div>
            </div>
        </div>
    }
    @if (User.IsInRole(RolesSistema.Administrador))
    {
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <span class="badge bg-success mb-2">UC5</span>
                    <h5 class="card-title">Consultar listado de sucursales</h5>
                    <p class="card-text small text-muted mb-1">Responsable: Yubidsa Gabriela Bueno Cocarico</p>
                    <p class="card-text small text-muted">Roles: Administrador</p>
                    <a class="btn btn-outline-success btn-sm" asp-area="Sucursales" asp-controller="ListadoSucursales" asp-action="Index">Abrir</a>
                </div>
            </div>
        </div>
    }
</div>
