@{
    ViewData["Title"] = "Material y Proveedores";
}

<h2>Material y Proveedores</h2>
<p class="text-muted">Equipo Mapache. Proveedores, compras de material, stock por sucursal, umbrales y alertas de bajo stock.</p>

<div class="row g-3">
    @if (User.IsInRole(RolesSistema.Administrador) || User.IsInRole(RolesSistema.Supervisor))
    {
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <span class="badge bg-success mb-2">UC6</span>
                    <h5 class="card-title">Registrar proveedor</h5>
                    <p class="card-text small text-muted mb-1">Responsable: Yubidsa Gabriela Bueno Cocarico</p>
                    <p class="card-text small text-muted">Roles: Administrador, Supervisor</p>
                    <a class="btn btn-outline-success btn-sm" asp-area="Inventario" asp-controller="RegistrarProveedor" asp-action="Index">Abrir</a>
                </div>
            </div>
        </div>
    }
    @if (User.IsInRole(RolesSistema.Administrador) || User.IsInRole(RolesSistema.Supervisor))
    {
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <span class="badge bg-success mb-2">UC7</span>
                    <h5 class="card-title">Editar datos de proveedor</h5>
                    <p class="card-text small text-muted mb-1">Responsable: Yubidsa Gabriela Bueno Cocarico</p>
                    <p class="card-text small text-muted">Roles: Administrador, Supervisor</p>
                    <a class="btn btn-outline-success btn-sm" asp-area="Inventario" asp-controller="EditarProveedor" asp-action="Index">Abrir</a>
                </div>
            </div>
        </div>
    }
    @if (User.IsInRole(RolesSistema.Administrador) || User.IsInRole(RolesSistema.Supervisor))
    {
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <span class="badge bg-success mb-2">UC8</span>
                    <h5 class="card-title">Registrar compra de material</h5>
                    <p class="card-text small text-muted mb-1">Responsable: Yubidsa Gabriela Bueno Cocarico</p>
                    <p class="card-text small text-muted">Roles: Administrador, Supervisor</p>
                    <a class="btn btn-outline-success btn-sm" asp-area="Inventario" asp-controller="RegistrarCompra" asp-action="Index">Abrir</a>
                </div>
            </div>
        </div>
    }
    @if (User.IsInRole(RolesSistema.Administrador) || User.IsInRole(RolesSistema.Supervisor))
    {
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <span class="badge bg-success mb-2">UC9</span>
                    <h5 class="card-title">Consultar stock de materiales</h5>
                    <p class="card-text small text-muted mb-1">Responsable: Roberto Carlos Herrera Coca</p>
                    <p class="card-text small text-muted">Roles: Administrador, Supervisor</p>
                    <a class="btn btn-outline-success btn-sm" asp-area="Inventario" asp-controller="StockMateriales" asp-action="Index">Abrir</a>
                </div>
            </div>
        </div>
    }
    @if (User.IsInRole(RolesSistema.Administrador))
    {
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <span class="badge bg-success mb-2">UC10</span>
                    <h5 class="card-title">Dar de baja proveedor</h5>
                    <p class="card-text small text-muted mb-1">Responsable: Roberto Carlos Herrera Coca</p>
                    <p class="card-text small text-muted">Roles: Administrador</p>
                    <a class="btn btn-outline-success btn-sm" asp-area="Inventario" asp-controller="BajaProveedor" asp-action="Index">Abrir</a>
                </div>
            </div>
        </div>
    }
    @if (User.IsInRole(RolesSistema.Administrador) || User.IsInRole(RolesSistema.Supervisor))
    {
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <span class="badge bg-success mb-2">UC11</span>
                    <h5 class="card-title">Notificar bajo stock de material</h5>
                    <p class="card-text small text-muted mb-1">Responsable: Roberto Carlos Herrera Coca</p>
                    <p class="card-text small text-muted">Roles: Administrador, Supervisor</p>
                    <a class="btn btn-outline-success btn-sm" asp-area="Inventario" asp-controller="AlertasStock" asp-action="Index">Abrir</a>
                </div>
            </div>
        </div>
    }
    @if (User.IsInRole(RolesSistema.Administrador) || User.IsInRole(RolesSistema.Supervisor))
    {
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <span class="badge bg-success mb-2">UC12</span>
                    <h5 class="card-title">Configurar umbral mínimo de material</h5>
                    <p class="card-text small text-muted mb-1">Responsable: Roberto Carlos Herrera Coca</p>
                    <p class="card-text small text-muted">Roles: Administrador, Supervisor</p>
                    <a class="btn btn-outline-success btn-sm" asp-area="Inventario" asp-controller="UmbralMaterial" asp-action="Index">Abrir</a>
                </div>
            </div>
        </div>
    }
</div>
